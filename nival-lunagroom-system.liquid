<!-- sections/nival-lunagroom-system.liquid - SISTEMA COMPLETO 15 PEZZI - Stile Dyson -->
<div style="background:#F5F5F7; padding:80px 24px; font-family: Inter, -apple-system; border-radius:24px">
  <div style="max-width:1200px; margin:0 auto">
