<!-- sections/nival-lunagroom-dark.liquid - Nival Cyberspace dark hero inspired by motionsites.ai/?prompt=nival-cyberspace -->
<div class="nival-dark" style="background:#0A0A0A; padding:100px 24px; position:relative; overflow:hidden; border-radius:24px">
  <!-- grid -->
  <div style="position:absolute; inset:0; background-image: linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px); background-size: 60px 60px; opacity:0.4"></div>
  <!-- glowing ring - css animation -->
  <div style="position:absolute; top:18%; left:50%; transform:translateX(-50%); width:420px; height:80px; border:2px solid #FFC24C; border-radius:50%; box-shadow:0 0 40px #FFC24C, inset 0 0 20px #FFC24C; opacity:0.8; animation: floatRing 6s ease-in-out infinite"></div>
  <style>@keyframes floatRing{0%,100%{transform:translateX(-50%) translateY(0) rotateX(75deg)}50%{transform:translateX(-50%) translateY(-10px) rotateX(75deg)}}</style>
  <div style="position:relative; max-width:1100px; margin:0 auto; text-align:center">
    <h1 style="font-size:68px; font-weight:700; color:white; letter-spacing:-2px; line-height:0.95">NIVAL GROOM LAB</h1>
    <p style="color:#999; font-size:18px; margin:16px auto 40px">Cyberspace grooming. Zero peli. Zero rumore.</p>
    <img src="{{ 'lunagroom-nival-dark.webp' | asset_url }}" alt="LunaGroom Nival" style="width:100%; max-width:820px; margin:0 auto; display:block">
  </div>
</div>
